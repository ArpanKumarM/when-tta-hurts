# Data (never commit datasets)
data/raw/
data/processed/
*.npz

# Results (generated artifacts, regenerated from raw + scripts; per-run data can be large)
results/runs/
results/figures/*.png
results/figures/*.pdf
!results/README.md

# Pilot/benchmark/experiment artifacts, checkpoints, caches -- large/generated,
# never committed. The three append-only research-record ledgers are the
# narrow exception: they're small, human-auditable CSVs that document run
# history (including aborted/incident runs) and are tracked deliberately.
# artifacts/confirmatory/ (per-run checkpoints/status files) stays ignored.
artifacts/*
!artifacts/ledger.csv
!artifacts/ledger_incidents.csv
!artifacts/ledger_confirmatory.csv
!artifacts/ledger_amendments.csv
# Phase 2B.4A validation-only TTA-evaluation ledger -- same append-only,
# human-auditable-CSV rationale as the ledgers above. Committed header-only
# during this engineering phase (no evaluation has run yet).
!artifacts/ledger_validation_evaluation.csv
# Phase 2B.4D evaluation-amendments ledger (mirrors artifacts/ledger_amendments.csv's
# eligibility-overlay rationale) -- excludes canonical-ineligible completed
# evaluation attempts without deleting their records.
!artifacts/ledger_validation_evaluation_amendments.csv
# The canonical Block D runtime-gate decision (INCLUDED/OMITTED) is a small,
# permanent, machine-readable record -- tracked deliberately, unlike the
# detailed raw benchmark timing dump it's derived from (artifacts/benchmarks/,
# which stays ignored).
!artifacts/block_d_gate_decision.json
# Phase 2B.6A final-test-evaluation ledger -- same append-only, human-
# auditable-CSV rationale as the ledgers above. Committed header-only
# during this engineering phase (no final-test evaluation has run yet).
# artifacts/final_test/ (per-attempt predictions/metrics/status files)
# stays ignored, same as artifacts/validation_evaluation/.
!artifacts/ledger_final_test.csv
# The final-test authorization artifact must be committed and tracked
# (its own tracked-and-clean-in-git state is part of what
# verify_final_test_authorization() checks) -- explicitly excepted here so
# a future, separately-authorized approval can be added with a normal
# `git add`, never a force-add workaround. Does NOT exist yet: creating it
# is explicitly out of scope for Phase 2B.6A engineering.
!artifacts/final_test_authorization.json
# Phase 2B.6K validation-metric reconciliation ledger (same append-only,
# human-auditable-CSV rationale as the ledgers above) plus its per-cell
# corrected-original-anchored-metric evidence records -- these JSON
# records ARE the reconciliation deliverable (small, not bulky
# predictions/model output), unlike artifacts/validation_evaluation/'s
# per-attempt predictions.npz/metrics.json, which stay ignored.
!artifacts/ledger_validation_reconciliation.csv
!artifacts/validation_evaluation_reconciliation/
!artifacts/validation_evaluation_reconciliation/**
# Phase 2B.7A final-test-analysis authorization gate -- same tracked-and-
# clean-in-git rationale as artifacts/final_test_authorization.json above.
# Does not itself authorize a real analysis run (see
# docs/phase2b_final_test_analysis_authorization_audit.md); the future
# real-analysis ledger/result directories stay ignored until that
# separately-authorized step actually runs.
!artifacts/final_test_analysis_authorization.json
# Phase 2B.7D: the sealed final-test-analysis lifecycle ledger and its
# completed attempt directories are the analysis deliverable itself
# (small, opaque-hash-bearing JSON, not bulky predictions/model output --
# same rationale as artifacts/validation_evaluation_reconciliation/
# above), tracked once a real analysis has actually completed. Narrowly
# scoped to exactly these two paths -- does NOT unignore
# artifacts/final_test/ (per-attempt evaluation predictions.npz/
# metrics.json, which stay ignored) or any other artifacts/ subtree.
!artifacts/ledger_final_test_analysis.csv
!artifacts/final_test_analysis/
!artifacts/final_test_analysis/**
!artifacts/final_test_cross_condition/
!artifacts/final_test_cross_condition/**
# Phase 2B.8A: the machine-readable scientific summary and the sealed
# unsealing authorization gate -- same tracked-and-clean-in-git rationale
# as the other authorization/ledger artifacts above. Narrowly scoped to
# exactly these two files; does not unignore anything else.
!artifacts/final_test_scientific_summary.json
!artifacts/final_test_unsealing_authorization.json
# Phase 2B.8C: archived generation-1 machine-readable scientific summary
# (byte-identical historical copy, preserved after the generator's one-
# sentence wording correction). Narrowly scoped to exactly this one
# archived path -- does not unignore any other file under
# artifacts/final_test_scientific_unsealing/.
!artifacts/final_test_scientific_unsealing/
!artifacts/final_test_scientific_unsealing/generation_001/
!artifacts/final_test_scientific_unsealing/generation_001/final_test_scientific_summary.json
# Phase 2B.9A: downstream, presentation-only paper-evidence figures/
# tables/manifest, deterministically generated from the sealed
# generation-2 canonical summary via the isolated tools/paper_evidence
# toolchain. Narrowly scoped to this one subtree -- does not unignore
# any other artifacts/ path.
!artifacts/paper_evidence/
!artifacts/paper_evidence/**
# Phase 2C / 2C.2 post-review analyses: small, human-auditable summary
# JSON + CSV tables that ARE the deliverable and back the manuscript's
# "Extended Analyses" numeric-traceability check (same rationale as
# artifacts/paper_evidence/ above). The bulky/regenerable parts stay
# ignored: label_preservation_audit/views/ (PNG renders) and every
# *.npz (already covered by the global *.npz rule, incl. the
# component_ablation/_cache/ resume cache).
!artifacts/secondary_analysis_expansion/
!artifacts/secondary_analysis_expansion/**
!artifacts/label_preservation_audit/
!artifacts/label_preservation_audit/**
artifacts/label_preservation_audit/views/
!artifacts/component_ablation/
!artifacts/component_ablation/**
artifacts/component_ablation/_cache/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store

# Editors
.vscode/
.idea/

# Logs / env
*.log
.env

# Local Claude Code session state (not project content)
.claude/
